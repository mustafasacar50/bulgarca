          {"bg":"Добро утро!","tr":"Günaydın!"},
          {"bg":"Добър ден!","tr":"İyi günler!"},
          {"bg":"Добър вечер!","tr":"İyi akşamlar!"},
          {"bg":"Лека нощ!","tr":"İyi geceler!"},
          {"bg":"Довиждане!","tr":"Hoşça kalın / Görüşürüz!"},
          {"bg":"Приятно ми е!","tr":"Memnun oldum!"}
        ]}
      ]
    },
