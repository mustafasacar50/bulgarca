        {"type":"dialog_cards","items":[
          {"title_tr":"Diyalog 1","lines":[{"bg":"Здравей! Как се казваш?","tr":"Merhaba! Adın ne?"},{"bg":"Казвам се Мустафа.","tr":"Benim adım Mustafa."},{"bg":"Приятно ми е.","tr":"Memnun oldum."},{"bg":"И на мен.","tr":"Ben de memnun oldum."}]},
          {"title_tr":"Diyalog 2","lines":[{"bg":"Добър ден! Вие лекар ли сте?","tr":"İyi günler! Siz doktor musunuz?"},{"bg":"Да, аз съм лекар.","tr":"Evet, ben doktorum."},{"bg":"А аз съм студент.","tr":"Ben de öğrenciyim."}]}
