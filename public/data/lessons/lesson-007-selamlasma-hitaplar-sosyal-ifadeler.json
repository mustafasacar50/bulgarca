    {
      "section_id": "l007-s05",
      "type": "dialogue",
      "title_tr": "Diyalog: Как се казвате?",
      "description_tr": "Kaynak diyalog uzun olduğu için öğrenme uygulamasında parçalara ayrıldı. Varsayılan modda Bulgarca görünür, Türkçe hover/panelde çıkar.",
      "lines": [
        {
          "speaker": "Преподавателка",
          "bg": "Добър ден!",
          "tr": "İyi günler!"
        },
        {
          "speaker": "Студент",
          "bg": "Добър ден!",
          "tr": "İyi günler!"
        },
        {
          "speaker": "Преподавателка",
          "bg": "Аз съм вашата преподавателка по български език.",
          "tr": "Ben sizin Bulgarca öğretmeninizim."
        },
        {
          "speaker": "Преподавателка",
          "bg": "Казвам се Станка Донева.",
          "tr": "Adım Stanka Doneva."
        },
        {
          "speaker": "Преподавателка",
          "bg": "А Вие как се казвате?",
          "tr": "Peki sizin adınız ne?"
        },
        {
          "speaker": "Студент",
          "bg": "Аз се казвам Симеон Димитров.",
          "tr": "Benim adım Simeon Dimitrov."
        },
        {
          "speaker": "Преподавателка",
          "bg": "Благодаря! А Вие кой сте?",
          "tr": "Teşekkürler! Peki siz kimsiniz?"
        },
        {
          "speaker": "Студент",
          "bg": "Аз съм Димитър Петров.",
          "tr": "Ben Dimitır Petrov’um."
        },
        {
          "speaker": "Преподавателка",
          "bg": "Извинете, не чух добре. Бихте ли повторили?",
          "tr": "Affedersiniz, iyi duymadım. Tekrar eder misiniz?"
        },
        {
          "speaker": "Студент",
          "bg": "Да. Румен Василев.",
          "tr": "Evet. Rumen Vasilev."
        },
        {
          "speaker": "Преподавателка",
          "bg": "Беше ми приятно да се запозная с вас.",
          "tr": "Sizinle tanıştığıma memnun oldum."
        },
        {
          "speaker": "Студенти",
          "bg": "Ние също се радваме, че се запознахме с Вас!",
          "tr": "Biz de sizinle tanıştığımıza sevindik!"
        }
      ],
