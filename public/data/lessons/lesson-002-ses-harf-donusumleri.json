    {
      "section_id": "l008-s02",
      "type": "rule_cards",
      "title_tr": "Ь, ьо, дж, дз ve ses benzeşmeleri",
      "rules": [
        {
          "rule_id": "soft-sign-yo",
          "title_tr": "Ьо / ьо",
          "summary_tr": "Ь tek başına ses vermez; bazı kelimelerde önceki sesi yumuşatır ve йо/yo benzeri okuma oluşturabilir.",
          "examples": [
            {
              "bg": "синьо",
              "tr": "mavi"
            },
            {
              "bg": "шофьор",
              "tr": "şoför"
            },
            {
              "bg": "миньор",
              "tr": "madenci"
            }
          ]
        },
        {
          "rule_id": "special-dzh",
          "title_tr": "Дж = c / dzh sesi",
          "summary_tr": "Дж Türkçedeki c sesine yakın duyulabilir.",
          "examples": [
            {
              "bg": "суджук",
              "tr": "sucuk"
            },
            {
              "bg": "надживея",
              "tr": "hayatta kalmak / daha uzun yaşamak"
            }
          ]
        },
        {
          "rule_id": "special-dz",
          "title_tr": "Дз = dz sesi",
          "summary_tr": "Дз başlangıçta ayrı bir ses birleşimi olarak görülür.",
          "examples": [
            {
              "bg": "дзън",
              "tr": "çın / zil sesi"
            },
            {
              "bg": "дзифт",
              "tr": "zift"
            }
          ]
        },
