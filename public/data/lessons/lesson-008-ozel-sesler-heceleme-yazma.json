      "section_id": "l008-s01",
      "type": "rule_cards",
      "title_tr": "Özel harf ve sesler",
      "rules": [
        {
          "rule_id": "alphabet-yu-two-sounds",
          "title_tr": "Ю = й + у",
          "summary_tr": "Ю harfi kelime içinde yu benzeri bir etki verir.",
          "examples": [
            {
              "bg": "ютия",
              "tr": "ütü"
            },
            {
              "bg": "юрган",
              "tr": "yorgan"
            }
          ]
        },
        {
          "rule_id": "alphabet-ya-two-sounds",
          "title_tr": "Я = й + а",
          "summary_tr": "Я harfi ya benzeri bir etki verir.",
          "examples": [
            {
              "bg": "ябълка",
              "tr": "elma"
            },
            {
              "bg": "ято",
              "tr": "sürü / kuş sürüsü"
            }
          ]
        },
        {
          "rule_id": "alphabet-sht-two-sounds",
          "title_tr": "Щ = ш + т",
          "summary_tr": "Щ genellikle sht gibi translitere edilir.",
          "examples": [
            {
              "bg": "щъркел",
              "tr": "leylek"
            },
