  "learning_goals": [
    "Bulgarcada bazı harflerin tek işaretle iki sese yakın değer taşıdığını fark etmek.",
    "Ünlü harfleri tanıyıp hece sayısını sezmek.",
    "Ь, ДЖ, ДЗ gibi başlangıçta karışabilecek yapıları ayırt etmek.",
    "Ortak kelimelerle el yazısı alıştırması yapmak."
  ],
  "sections": [
