              "bg": "щраус",
              "tr": "devekuşu"
            }
          ]
        },
        {
          "rule_id": "alphabet-y-short",
          "title_tr": "Й — kısa y sesi",
          "summary_tr": "Й yarı ünlü gibi davranır; Türkçedeki y sesine yakın düşünülebilir.",
          "examples": [
            {
              "bg": "лейка",
              "tr": "sulama kabı"
            },
            {
              "bg": "йена",
              "tr": "yen"
            }
          ]
        }
